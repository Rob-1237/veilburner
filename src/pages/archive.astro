---
import Layout from '../layouts/Layout.astro';
import BrandMark from '../components/BrandMark.astro';
import ReleaseCta from '../components/ReleaseCta.astro';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
import { albums } from '../data/albums.js';
import { reviews } from '../data/reviews.js';
import { interviewsWritten } from '../data/interviews-written.js';
import { interviews } from '../data/interviews.js';
import { media } from '../data/media.js';

// Album reviews grouped by album, newest release first (matches recency conventions
// and surfaces current-era press before the back catalogue).
const albumOrder = albums; // albums.js is already newest-first
const reviewsByAlbum = albumOrder
  .map((a) => ({ album: a, items: reviews.filter((r) => r.album === a.title) }))
  .filter((g) => g.items.length > 0);

// Reels: self-hosted mp4 plays inline; else YouTube embeds; else a platform link-card.
const reelType = (reel) => {
  if (reel.videoSrc) return 'mp4';
  const l = reel.link || '';
  if (l.includes('youtube.com') || l.includes('youtu.be')) return 'youtube';
  if (l.includes('instagram.com')) return 'instagram';
  if (l.includes('facebook.com')) return 'facebook';
  return 'link';
};
const youtubeId = (link = '') => {
  const m =
    link.match(/shorts\/([\w-]+)/) ||
    link.match(/[?&]v=([\w-]+)/) ||
    link.match(/youtu\.be\/([\w-]+)/);
  return m ? m[1] : '';
};
---

<Layout title="VEILBURNER - Archive">
  <BrandMark />
  <ReleaseCta floating />
  <h1 class="archive-page__title">ARCHIVE</h1>
  <section class="archive-page">
    <div class="container">

      <!-- 1. Reviews (Written) Section -->
      <section class="archive-section collapsed" data-section="reviews">
        <div class="archive-section__header">
          <h2 class="archive-section__title">ALBUM REVIEWS</h2>
          <button class="archive-section__toggle" aria-expanded="false" aria-label="Toggle Reviews section">
            <span class="section-toggle-icon">🜃</span>
          </button>
        </div>
        <div class="archive-section__content-wrapper">
          <div class="archive-section__content">
            {reviewsByAlbum.map((group) => (
            <div class="review-group">
              <h3 class="review-group__album">{group.album.title} <span class="review-group__year">{group.album.year}</span></h3>
              {group.items.map((review) => (
              <div class="review-card">
                <div class="review-card__content">
                  <blockquote class="review-card__quote">"{review.quote}"</blockquote>
                  <div class="review-card__attribution">
                    <span>— {review.publication}, {review.date}<span class="review-author">&nbsp;{review.author}</span></span>
                    <button class="review-card__toggle" aria-expanded="false" aria-label="Expand review">
                      <span class="toggle-icon">🜁</span>
                    </button>
                  </div>
                  <div class="review-card__expandable">
                    <div class="review-card__expandable-content">
                      <div class="review-card__full-text">
                        <p>{review.fullText}</p>
                        {review.rating && (
                          <p class="review-card__meta"><strong>Rating:</strong> {review.rating}</p>
                        )}
                      </div>
                      {review.link && (
                        <a href={review.link} target="_blank" rel="noopener noreferrer" class="review-card__link">
                          Read Full Review →
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
              ))}
            </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 2. Interviews (Written) Section -->
      <section class="archive-section collapsed" data-section="interviews">
        <div class="archive-section__header">
          <h2 class="archive-section__title">INTERVIEWS</h2>
          <button class="archive-section__toggle" aria-expanded="false" aria-label="Toggle Interviews section">
            <span class="section-toggle-icon">🜃</span>
          </button>
        </div>
        <div class="archive-section__content-wrapper">
          <div class="archive-section__content">
            {interviewsWritten.map((interview, index) => (
            <div class="review-card" data-item-id={index}>
              <div class="review-card__content">
                <blockquote class="review-card__quote">"{interview.quote}"</blockquote>
                <div class="review-card__attribution">
                  <span>— {interview.publication}, {interview.date}</span>
                  <button class="review-card__toggle" aria-expanded="false" aria-label="Expand interview">
                    <span class="toggle-icon">🜁</span>
                  </button>
                </div>
                <div class="review-card__expandable">
                  <div class="review-card__expandable-content">
                    <div class="review-card__full-text">
                      <p>{interview.fullText}</p>
                    </div>
                    {interview.link && (
                      <a href={interview.link} target="_blank" rel="noopener noreferrer" class="review-card__link">
                        Read Full Interview →
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
          </div>
        </div>
      </section>

      <!-- 4. Video Interviews Section -->
      <section class="archive-section collapsed" data-section="video-interviews">
        <div class="archive-section__header">
          <h2 class="archive-section__title">VIDEO INTERVIEWS</h2>
          <button class="archive-section__toggle" aria-expanded="false" aria-label="Toggle Video Interviews section">
            <span class="section-toggle-icon">🜃</span>
          </button>
        </div>
        <div class="archive-section__content-wrapper">
          <div class="archive-section__content">
            <div class="media-grid">
              {interviews.map((video) => (
              <div class="media-embed">
                <h3 class="media-embed__title">{video.title}</h3>
                <div class="media-embed__wrapper">
                  <iframe
                    width="800"
                    height="450"
                    src={`https://www.youtube.com/embed/${video.videoId}?theme=dark&modestbranding=1&rel=0`}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Video Reviews Section -->
      <section class="archive-section collapsed" data-section="video-reviews">
        <div class="archive-section__header">
          <h2 class="archive-section__title">VIDEO REVIEWS</h2>
          <button class="archive-section__toggle" aria-expanded="false" aria-label="Toggle Video Reviews section">
            <span class="section-toggle-icon">🜃</span>
          </button>
        </div>
        <div class="archive-section__content-wrapper">
          <div class="archive-section__content">
            <div class="media-grid">
              {media.videoReviews.map((video) => (
              <div class="media-embed">
                <h3 class="media-embed__title">{video.title}</h3>
                <div class="media-embed__wrapper">
                  <iframe
                    width="800"
                    height="450"
                    src={`https://www.youtube.com/embed/${video.videoId}?theme=dark&modestbranding=1&rel=0`}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 6. Video Misc Section -->
      <section class="archive-section collapsed" data-section="video-misc">
        <div class="archive-section__header">
          <h2 class="archive-section__title">VIDEO MISC</h2>
          <button class="archive-section__toggle" aria-expanded="false" aria-label="Toggle Video Misc section">
            <span class="section-toggle-icon">🜃</span>
          </button>
        </div>
        <div class="archive-section__content-wrapper">
          <div class="archive-section__content">
            <div class="media-grid">
              {media.videoMisc.map((video) => (
              <div class="media-embed">
                <h3 class="media-embed__title">{video.title}</h3>
                <div class="media-embed__wrapper">
                  <iframe
                    width="800"
                    height="450"
                    src={`https://www.youtube.com/embed/${video.videoId}?theme=dark&modestbranding=1&rel=0`}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Reels Section -->
      <section class="archive-section collapsed" data-section="reels">
        <div class="archive-section__header">
          <h2 class="archive-section__title">REELS</h2>
          <button class="archive-section__toggle" aria-expanded="false" aria-label="Toggle Reels section">
            <span class="section-toggle-icon">🜃</span>
          </button>
        </div>
        <div class="archive-section__content-wrapper">
          <div class="archive-section__content">
            <div class="reels-grid">
              {media.reels.map((reel) => (
              <div class="reel-container">
                <h3 class="reel-container__title">{reel.title}</h3>
                {reelType(reel) === 'mp4' && (
                  <div class="reel-container__wrapper">
                    <video class="reel-embed" controls playsinline loop preload="metadata">
                      <source src={reel.videoSrc} type="video/mp4" />
                      Your browser does not support the video tag.
                    </video>
                  </div>
                )}
                {reelType(reel) === 'youtube' && (
                  <div class="reel-container__wrapper">
                    <iframe
                      class="reel-embed"
                      src={`https://www.youtube.com/embed/${youtubeId(reel.link)}`}
                      title={reel.title}
                      loading="lazy"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </div>
                )}
                {(reelType(reel) === 'instagram' || reelType(reel) === 'facebook') && (
                  <a href={reel.link} target="_blank" rel="noopener noreferrer" class="reel-container__wrapper reel-card">
                    <Icon name={reelType(reel)} class="reel-card__icon" />
                    <span class="reel-card__label">Watch on {reelType(reel) === 'instagram' ? 'Instagram' : 'Facebook'} →</span>
                  </a>
                )}
                {(reelType(reel) === 'youtube' || reelType(reel) === 'mp4') && reel.link && (
                  <a href={reel.link} target="_blank" rel="noopener noreferrer" class="reel-container__link">
                    View Original →
                  </a>
                )}
              </div>
            ))}
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>
  <Footer />
</Layout>

<style lang="scss">
  @import '../styles/tokens';

  .archive-page {
    padding: 4.5rem 1.125rem 2.25rem;
    min-height: 100vh;

    &__title {
      font-family: $font-metal;
      color: var(--color-rust);
      font-size: 2.25rem;
      text-align: center;
      padding-top: 6rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-weight: 300;

      @media (max-width: 768px) {
        font-size: 2.25rem;
      }
    }
  }

  .archive-section {
    margin-bottom: 4.5rem;

    &__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      cursor: pointer;
      user-select: none;

      // Keep the toggle glyph clear of the fixed Sigil Spine column on mobile
      @media (max-width: 768px) {
        padding-right: 1.8rem;
      }

      &:hover .archive-section__title {
        color: var(--color-rust); // Rust on hover
      }
    }

    &__title {
      font-family: $font-body;
      font-size: 1.25rem;
      margin-bottom: 0;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-weight: 300;
      color: var(--color-bone); // Bone
      transition: color 0.3s ease;

      @media (max-width: 768px) {
        font-size: 1.25rem;
      }
    }

    &__toggle {
      background: none;
      border: none;
      color: var(--color-bone); // Bone
      font-size: 1.5rem;
      cursor: pointer;
      padding: 0;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.3s ease;
      flex-shrink: 0;

      &:hover {
        color: var(--color-rust); // Rust
      }

      @media (max-width: 768px) {
        width: 26.25px;
        height: 26.25px;
        font-size: 1.3125rem;
      }
    }

    .section-toggle-icon {
      display: inline-block;
      position: relative;
      transition: transform 0.3s ease;
    }

    &__toggle:hover .section-toggle-icon {
      transform: rotate(180deg);
    }

    // When collapsed, hide the HTML content and show plus via ::before
    &.collapsed .section-toggle-icon {
      font-size: 0; // Hide the HTML "−"

      &::before {
        content: '🜁';
        font-size: 1.5rem;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);

        @media (max-width: 768px) {
          font-size: 1.3125rem;
        }
      }
    }

    &__content-wrapper {
      display: grid;
      grid-template-rows: 1fr;
      transition: grid-template-rows 0.4s ease;
    }

    &.collapsed &__content-wrapper {
      grid-template-rows: 0fr;
    }

    &__content {
      max-width: 675px;
      margin: 0 auto;
      overflow: hidden;
    }
  }

  // Chronological album grouping for the reviews section
  .review-group {
    margin-bottom: 2.25rem;

    &:last-child {
      margin-bottom: 0;
    }

    &__album {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--color-bone);
      letter-spacing: 0.03em;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(139, 115, 85, 0.25);
    }

    &__year {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      color: var(--color-gray-medium);
      letter-spacing: 0.1em;
      margin-left: 0.5rem;
    }
  }

  // Review Cards (Accordion)
  .review-card {
    margin-bottom: 1.5rem;
    cursor: pointer;
    transition: transform 0.3s ease;

    &:hover {
      transform: translateX(3px);
    }

    &__content {
      padding: 1.5rem;
      border: 1.5px solid var(--color-rust); // Rust
      border-left: 4.5px solid var(--color-rust);
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%);
      background: linear-gradient(90deg, var(--surface-tint) 0%, transparent 100%);
      transition: all 0.4s ease;
    }

    &.expanded &__content {
      border-color: var(--color-bone); // Bone
      box-shadow: -3px 0 0 var(--color-rust);
    }

    &__quote {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      line-height: 1.6;
      color: var(--color-gray-light);
      margin: 0 0 1.125rem 0;
      font-style: italic;
    }

    &__expandable {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.4s ease;
    }

    &.expanded &__expandable {
      grid-template-rows: 1fr;
    }

    &__expandable-content {
      overflow: hidden;
    }

    &__full-text {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7125rem;
      line-height: 1.7;
      color: var(--color-gray-light);
      margin-bottom: 1.125rem;
      margin-top: 1.125rem;

      p {
        margin-bottom: 0.75rem;
      }
    }

    &__meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.675rem;
      color: var(--color-bone); // Bone
      margin-bottom: 0.375rem;

      strong {
        color: var(--color-rust); // Rust
      }
    }

    &__attribution {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.6375rem;
      color: var(--color-gray-medium);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    &__toggle {
      background: none;
      border: none;
      color: var(--color-bone); // Bone
      font-size: 1.125rem;
      cursor: pointer;
      padding: 0;
      width: 22.5px;
      height: 22.5px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.3s ease;

      &:hover {
        color: var(--color-rust); // Rust
      }
    }

    .toggle-icon {
      display: inline-block;
      position: relative;
      transition: transform 0.3s ease;
    }

    &__toggle:hover .toggle-icon {
      transform: rotate(180deg);
    }

    // When expanded, hide the HTML content and show minus via ::before
    &.expanded .toggle-icon {
      font-size: 0; // Hide the HTML "+"

      &::before {
        content: '🜃';
        font-size: 1.125rem;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }
    }

    &__link {
      display: inline-block;
      margin-top: 0.75rem;
      font-family: 'IBM Plex Mono', monospace;
      color: var(--color-rust); // Rust
      text-decoration: none;
      font-size: 0.675rem;
      transition: color 0.3s ease;

      &:hover {
        color: var(--color-bone); // Bone
      }
    }
  }

  .review-author {
    font-size: .6rem;
    font-style: italic;
    color: var(--color-rust);
    text-align: left;
    text-transform: lowercase;
  }

  // Media Grid
  .media-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  // Media Embeds
  .media-embed {
    display: flex;
    flex-direction: column;

    &__title {
      font-family: 'Inter', sans-serif;
      font-size: 0.675rem;
      color: var(--color-gray-medium); // Bone
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      line-height: 1.4;
      min-height: 2.25em; // Reserve space for ~3 lines of text
      display: flex;
      align-items: flex-start;
      font-weight: 300;

      @media (min-width: 768px) {
        font-size: 0.6375rem;
        min-height: 3.1875em; // Adjusted for smaller font
      }
    }

    &__wrapper {
      position: relative;
      width: 100%;
      border: 2.25px solid var(--color-rust); // Rust
      clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px);
      overflow: hidden;

      iframe {
        display: block;
        width: 100%;
        height: 225px;

        @media (min-width: 768px) {
          height: 187.5px;
        }

        @media (min-width: 1024px) {
          height: 225px;
        }
      }
    }
  }

  // Reels Grid (Vertical Video Players)
  .reels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    max-width: 525px;
    margin: 0 auto;

    @media (min-width: 768px) {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  .reel-container {
    display: flex;
    flex-direction: column;
    align-items: center;

    &__title {
      font-family: 'Oswald', sans-serif;
      font-size: 0.6375rem;
      color: var(--color-gray-medium); // Bone
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      line-height: 1.4;
      text-align: center;
      font-weight: 300;

      @media (min-width: 768px) {
        font-size: 0.6rem;
      }
    }

    &__wrapper {
      position: relative;
      width: 100%;
      max-width: 240px; // Mobile-friendly width
      aspect-ratio: 9 / 16; // Vertical short/reel format
      border: 2.25px solid var(--color-rust); // Rust
      clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px);
      overflow: hidden;
      background: #000;

      @media (max-width: 767px) {
        max-width: 210px;
      }
    }

    &__link {
      display: inline-block;
      margin-top: 0.75rem;
      font-family: 'Oswald', sans-serif;
      color: var(--color-rust); // Rust
      text-decoration: none;
      font-size: 0.6375rem;
      transition: color 0.3s ease;

      &:hover {
        color: var(--color-bone); // Bone
      }
    }
  }

  .reel-embed {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: cover; // fills the 9:16 frame (applies to the <video>; no-op on <iframe>)
  }

  // Instagram / Facebook link-card — reuses the 9:16 .reel-container__wrapper box
  .reel-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 1rem;
    text-align: center;
    text-decoration: none;
    color: var(--color-bone);
    --icon-size: 44px;
    background: linear-gradient(160deg, rgba(90, 58, 42, 0.14), transparent 70%);
    transition: color 0.3s ease, background 0.3s ease;

    &:hover,
    &:focus-visible {
      color: var(--color-rust);
      background: linear-gradient(160deg, rgba(90, 58, 42, 0.24), transparent 70%);
    }

    &__label {
      font-family: 'Oswald', sans-serif;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }
  }

  // A11y: keep collapsed content out of the keyboard tab order. Visibility flips
  // to hidden only after the 0.4s collapse animation, so the motion stays smooth.
  .archive-section__content-wrapper,
  .review-card__expandable {
    visibility: hidden;
    transition: grid-template-rows 0.4s ease, visibility 0s linear 0.4s;
  }
  .archive-section:not(.collapsed) .archive-section__content-wrapper,
  .review-card.expanded .review-card__expandable {
    visibility: visible;
    transition: grid-template-rows 0.4s ease, visibility 0s;
  }

</style>

<script>
  // Review-card accordion (one open at a time). The toggle <button> keeps
  // aria-expanded in sync so assistive tech announces the state.
  function initAccordion() {
    const cards = document.querySelectorAll<HTMLElement>('.review-card');

    cards.forEach((card) => {
      const toggle = card.querySelector('.review-card__toggle');

      card.addEventListener('click', (e) => {
        // Let the "Read full…" link behave normally
        if ((e.target as Element)?.closest('.review-card__link')) return;

        const willExpand = !card.classList.contains('expanded');

        // Accordion: close the others
        cards.forEach((other) => {
          if (other !== card) {
            other.classList.remove('expanded');
            other.querySelector('.review-card__toggle')?.setAttribute('aria-expanded', 'false');
          }
        });

        card.classList.toggle('expanded', willExpand);
        toggle?.setAttribute('aria-expanded', String(willExpand));
      });
    });
  }
  document.addEventListener('astro:page-load', initAccordion);

  // Section accordion (each opens/closes independently).
  function initSectionAccordion() {
    const sections = document.querySelectorAll<HTMLElement>('.archive-section');

    sections.forEach((section) => {
      const header = section.querySelector('.archive-section__header');
      const toggle = section.querySelector('.archive-section__toggle');
      if (!header || !toggle) return;

      header.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = section.classList.contains('collapsed'); // collapsed → will open
        section.classList.toggle('collapsed');
        toggle.setAttribute('aria-expanded', String(willOpen));
      });
    });
  }
  document.addEventListener('astro:page-load', initSectionAccordion);

  // Reels: click/tap to play (loops); pause when scrolled out of view; one at a time.
  function initReels() {
    const vids = document.querySelectorAll<HTMLVideoElement>('.reel-embed');
    if (!vids.length) return;

    vids.forEach((v) => {
      // Starting one reel pauses the others
      v.addEventListener('play', () => {
        vids.forEach((other) => {
          if (other !== v) other.pause();
        });
      });
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) (e.target as HTMLVideoElement).pause();
          });
        },
        { threshold: 0.2 },
      );
      vids.forEach((v) => io.observe(v));
    }
  }
  document.addEventListener('astro:page-load', initReels);
</script>
